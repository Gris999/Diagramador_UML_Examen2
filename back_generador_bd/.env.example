# Django
DJANGO_SECRET_KEY=change-me
DEBUG=True
# Add every public host/IP this backend is actually served behind (comma-separated).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django_backend_UML
# Add every origin the Angular frontend is actually served from (comma-separated,
# scheme+host+port, no trailing slash, no wildcards). A production deployment
# (e.g. EC2) MUST add its own origin here or the browser will block every
# cross-origin request with "No 'Access-Control-Allow-Origin' header is present".
# Example for a deployment behind HTTPS: https://your-domain.example
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4000
# Must match CORS_ALLOWED_ORIGINS for any origin that submits POST/PUT/PATCH/DELETE
# requests, or Django's CSRF check will reject them even once CORS itself allows them.
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://localhost:4000

# PostgreSQL
POSTGRES_DB=uml_bd
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis_server
REDIS_PORT=6379

# Gemini
GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-3.8-flash

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# Chat AI provider: gemini (cloud, default) or ollama (local model, see docs/IA_LOCAL.md)
# AI_PROVIDER=gemini
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_CHANGE_MODEL=uml-qwen-dia3   # modelo reentrenado (ml/) solo para los cambios al diagrama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
